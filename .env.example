# API
PORT=3090
# Interface the API listens on (default 127.0.0.1; set 0.0.0.0 only to reach it from another machine)
# HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dait_crm
# Absolute path to the built web app (apps/web/dist); when set the API serves it
# WEB_DIST=
# Release label returned by /api/health
# RELEASE=dev

# Auth
# Public origin of the app; https:// turns on Secure cookies
PUBLIC_URL=
# Signs short-lived auth cookies (32+ random characters; required in production)
SESSION_SECRET=
# Encrypts stored mailbox refresh tokens (AES-256-GCM; 32 random bytes, base64).
# Generate with: openssl rand -base64 32   (changing it disconnects every mailbox)
TOKEN_ENCRYPTION_KEY=
# Microsoft Entra app registration (sign-in is disabled while MS_CLIENT_ID is empty)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# e.g. <PUBLIC_URL>/api/auth/microsoft/callback
MS_REDIRECT_URI=
# 1 = enable break-glass local admin password login (POST /api/auth/local)
LOCAL_ADMIN_LOGIN=
# 1 = enable passwordless test login (ignored when NODE_ENV=production; never set in production)
TEST_LOGIN=
