{
  "name": "@dait-crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "create-local-admin": "tsx src/cli/create-local-admin.ts",
    "e2e:seed": "tsx test/e2e-seed.ts"
  },
  "dependencies": {
    "@azure/msal-node": "3.8.10",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "node-html-parser": "9.0.7",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.20.2",
    "prisma": "6.19.3",
    "tldts": "6.1.86",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "tsx ../../prisma/seed.ts"
  }
}
