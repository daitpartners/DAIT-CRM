generator client {
  provider      = "prisma-client-js"
  // native for development and CI; rhel-openssl-3.0.x for the AlmaLinux 9 server.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  MANAGER
  SALES_REPRESENTATIVE
  DATA_RESEARCH_USER

  @@map("role")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  role         Role
  language     String    @default("en")
  timezone     String    @default("Europe/London")
  dateFormat   String    @default("DD MMM YYYY") @map("date_format")
  isActive     Boolean   @default(true) @map("is_active")
  microsoftOid String?   @unique @map("microsoft_oid")
  lastLoginAt  DateTime? @map("last_login_at")
  passwordHash String?   @map("password_hash")
  isLocalAdmin Boolean   @default(false) @map("is_local_admin")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  emailAccounts  EmailAccount[]
  emailTemplates EmailTemplate[]
  emailMessages  EmailMessage[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  createdCompanies Company[]

  assignedLeads   Lead[]           @relation("LeadAssignee")
  createdLeads    Lead[]           @relation("LeadCreator")
  leadActivities  LeadActivity[]
  assignmentsFrom LeadAssignment[] @relation("AssignmentFrom")
  assignmentsTo   LeadAssignment[] @relation("AssignmentTo")
  assignmentsBy   LeadAssignment[] @relation("AssignmentBy")
  tasks           Task[]
  campaigns       EmailCampaign[]  @relation("CampaignSender")
  calendarEvents  CalendarEvent[]
  quotations      Quotation[]
  managedProjects Project[]        @relation("ProjectManager")
  createdProjects Project[]        @relation("ProjectCreator")

  enrichmentRuns     EnrichmentRun[]
  decidedSuggestions EnrichmentSuggestion[]

  @@map("users")
}

model Session {
  id         String   @id
  userId     Int      @map("user_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model LookupValue {
  id        Int     @id @default(autoincrement())
  group     String
  value     String
  label     String
  labelEs   String? @map("label_es")
  labelFr   String? @map("label_fr")
  sortOrder Int     @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@unique([group, value])
  @@map("lookup_values")
}

model AllocationRule {
  id             Int     @id @default(autoincrement())
  name           String
  matchCountries Json    @map("match_countries")
  /// Only leads in this outreach language; null = any.
  matchLanguage  String? @map("match_language") @db.Char(2)
  assignTo       Json    @map("assign_to")
  roundRobinPos  Int     @default(0) @map("round_robin_pos")
  priority       Int
  isActive       Boolean @default(true) @map("is_active")

  assignments LeadAssignment[]

  @@map("allocation_rules")
}

model EmailAccount {
  id                Int       @id @default(autoincrement())
  userId            Int?      @map("user_id")
  address           String
  /// Mailbox the CRM sends as (a shared mailbox the connecting user has Send-As on); null = `address`.
  sendAs            String?   @map("send_as")
  provider          String
  kind              String
  refreshTokenEnc   String    @map("refresh_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  status            String
  lastError         String?   @map("last_error")
  /// Release 2A personal mailbox options (prototype "Mailbox options"); sync itself arrives in 2B.
  syncMail          Boolean   @default(true) @map("sync_mail")
  syncCalendar      Boolean   @default(false) @map("sync_calendar")
  sharedMailboxes   String[]  @default([]) @map("shared_mailboxes")
  lastSyncAt        DateTime? @map("last_sync_at")
  messageCount      Int       @default(0) @map("message_count")
  /// Release 2B-2 mail sync: per folder `{ link }`, the Graph next or delta link to continue from.
  syncState         Json      @default("{}") @map("sync_state")
  /// Release 3C calendar sync: `{ link, userId, full?, at }` (Graph link to continue from; `full` while the first
  /// listing of a restart is still being read; `at` = last completed run).
  calendarSyncState Json?     @map("calendar_sync_state")
  /// When the calendar sync last restarted from scratch (daily, to roll the 30/180-day window).
  calendarSyncAt    DateTime? @map("calendar_sync_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages       EmailMessage[]
  campaigns      EmailCampaign[]
  calendarEvents CalendarEvent[]

  /// One system row and at most one personal row per user; the same address may be both (Deepak's).
  @@unique([address, kind])
  @@map("email_accounts")
}

/// A user's email (release 2B): sent from the CRM now, synced from their mailbox in 2B-2. Private to `userId`.
model EmailMessage {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  accountId       Int?      @map("account_id")
  leadId          Int?      @map("lead_id")
  contactId       Int?      @map("contact_id")
  companyId       Int?      @map("company_id")
  /// 'sent' | 'inbox' | 'drafts' | 'archive'
  folder          String
  /// 'queued' | 'sending' | 'sent' | 'failed' (sent from the CRM); synced mail is 'received' | 'sent' | 'draft'.
  status          String
  /// 'crm' written in the CRM | 'sync' read from the mailbox.
  source          String    @default("crm")
  fromAddress     String    @map("from_address")
  fromName        String?   @map("from_name") @db.VarChar(255)
  toAddresses     Json      @default("[]") @map("to_addresses")
  ccAddresses     Json      @default("[]") @map("cc_addresses")
  bccAddresses    Json      @default("[]") @map("bcc_addresses")
  /// The Mailer campaign that sent it (release 2C).
  campaignId      Int?      @map("campaign_id")
  /// The project the email was tagged with when sent (release 3B); a tag never widens who sees the message.
  projectId       Int?      @map("project_id")
  subject         String    @db.VarChar(500)
  bodyText        String    @default("") @map("body_text")
  /// Graph immutable id (2B-2 sync); unique per user.
  graphId         String?   @map("graph_id") @db.VarChar(255)
  /// RFC message id and Graph conversation id, filled by sync (2B-2).
  messageId       String?   @map("message_id") @db.VarChar(255)
  threadId        String?   @map("thread_id") @db.VarChar(255)
  isRead          Boolean   @default(true) @map("is_read")
  occurredAt      DateTime  @default(now()) @map("occurred_at")
  attachmentNames Json      @default("[]") @map("attachment_names")
  /// The message this one answers (a CRM reply goes through Graph reply).
  replyToId       Int?      @map("reply_to_id")
  /// When the user logged it on the lead ("Log as activity"); once per message.
  loggedAt        DateTime? @map("logged_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            EmailAccount?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lead               Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact            Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company            Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  replyTo            EmailMessage?            @relation("EmailReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  campaign           EmailCampaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project            Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaignRecipients EmailCampaignRecipient[]
  replies            EmailMessage[]           @relation("EmailReplies")
  sendingQuotations  Quotation[]

  @@unique([userId, graphId])
  @@index([userId, threadId])
  @@index([userId, leadId])
  @@index([userId, folder, occurredAt])
  @@index([userId, projectId])
  @@map("email_messages")
}

/// A copy of one event of a user's Outlook calendar (release 3C), read from their personal mailbox. Private to `userId`
/// (administrators included); deleted when Sync calendar is switched off or the mailbox disconnected.
model CalendarEvent {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  accountId         Int      @map("account_id")
  /// Graph immutable id (recurring occurrences have long ones); unique per user.
  graphId           String   @map("graph_id")
  subject           String   @db.VarChar(500)
  /// UTC; an all-day event runs from midnight to midnight UTC of its dates (Graph's own representation).
  startsAt          DateTime @map("starts_at")
  endsAt            DateTime @map("ends_at")
  isAllDay          Boolean  @default(false) @map("is_all_day")
  location          String?  @db.VarChar(500)
  organizerName     String?  @map("organizer_name") @db.VarChar(255)
  organizerAddress  String?  @map("organizer_address") @db.VarChar(320)
  /// Lower-cased attendee addresses (the organiser apart).
  attendeeAddresses Json     @default("[]") @map("attendee_addresses")
  isOnline          Boolean  @default(false) @map("is_online")
  /// An attendee's open lead the user could see when synced (mail matching rules); re-checked when read.
  leadId            Int?     @map("lead_id")
  companyId         Int?     @map("company_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead    Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, graphId])
  @@index([userId, startsAt])
  @@index([accountId])
  @@map("calendar_events")
}

/// Team email templates (release 2A): written in the CRM or read from an uploaded Outlook .oft (file not kept).
model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  language    String   @db.Char(2)
  subject     String   @db.VarChar(500)
  body        String   @default("")
  /// 'manual' | 'oft'
  sourceType  String   @map("source_type")
  fileName    String?  @map("file_name") @db.VarChar(255)
  fileSize    Int?     @map("file_size")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  campaigns EmailCampaign[]

  @@map("email_templates")
}

model Job {
  id          Int       @id @default(autoincrement())
  type        String
  payload     Json
  runAt       DateTime  @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(8) @map("max_attempts")
  status      String
  lastError   String?   @map("last_error")
  lockedAt    DateTime? @map("locked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("jobs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  text      String
  detail    String?
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  userId     Int?     @map("user_id")
  before     Json?
  after      Json?
  at         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Company {
  id                  Int       @id @default(autoincrement())
  /// CO-0001 ... CO-10000; next_company_number() over company_number_seq, defined in the migration SQL.
  number              String    @unique @default(dbgenerated("next_company_number()"))
  name                String
  /// normaliseCompanyName(name); set by the routes on every write, used for duplicate matching.
  nameNormalised      String    @map("name_normalised")
  legalName           String?   @map("legal_name")
  website             String?
  /// domainOf(website ?? businessEmail); first duplicate-check key.
  domain              String?   @unique
  businessEmail       String?   @map("business_email")
  industry            String?
  businessCategory    String?   @map("business_category")
  businessType        String?   @map("business_type")
  yearEstablished     Int?      @map("year_established") @db.SmallInt
  description         String?
  logoPath            String?   @map("logo_path")
  linkedinUrl         String?   @map("linkedin_url")
  status              String    @default("Active")
  isClient            Boolean   @default(false) @map("is_client")
  country             String
  state               String?
  city                String?
  street              String?
  zip                 String?
  timezone            String?
  lat                 Decimal?  @db.Decimal(9, 6)
  lng                 Decimal?  @db.Decimal(9, 6)
  mapsUrl             String?   @map("maps_url")
  employeeCount       Int?      @map("employee_count")
  employeeRange       String?   @map("employee_range")
  annualRevenue       Decimal?  @map("annual_revenue") @db.Decimal(18, 2)
  revenueCurrency     String?   @map("revenue_currency") @db.Char(3)
  revenueRange        String?   @map("revenue_range")
  ownershipType       String?   @map("ownership_type")
  registrationNumber  String?   @map("registration_number")
  stockExchange       String?   @map("stock_exchange")
  stockSymbol         String?   @map("stock_symbol")
  mainProducts        String?   @map("main_products")
  mainServices        String?   @map("main_services")
  businessVerticals   Json      @default("[]") @map("business_verticals")
  targetMarkets       Json      @default("[]") @map("target_markets")
  geographicMarkets   Json      @default("[]") @map("geographic_markets")
  keyBrands           String?   @map("key_brands")
  specialisation      String?
  socialFacebook      String?   @map("social_facebook")
  socialInstagram     String?   @map("social_instagram")
  socialX             String?   @map("social_x")
  socialYoutube       String?   @map("social_youtube")
  socialOther         String?   @map("social_other")
  websiteTechnology   String?   @map("website_technology")
  websiteAssessment   String?   @map("website_assessment")
  digitalSummary      String?   @map("digital_summary")
  aiSummary           String?   @map("ai_summary")
  aiIndustry          String?   @map("ai_industry")
  aiBusinessCategory  String?   @map("ai_business_category")
  aiPotentialServices Json      @default("[]") @map("ai_potential_services")
  aiOpportunityScore  Int?      @map("ai_opportunity_score") @db.SmallInt
  aiConfidence        String?   @map("ai_confidence")
  /// RESEARCH_STATUSES (shared): Not started (never researched) | Pending (queued) | Processing | Completed | Failed.
  aiResearchStatus    String    @default("Not started") @map("ai_research_status")
  aiLastResearchAt    DateTime? @map("ai_last_research_at")
  verificationStatus  String    @default("Unverified") @map("verification_status")
  verifiedFields      Json      @default("{}") @map("verified_fields")
  aiFields            Json      @default("{}") @map("ai_fields")
  createdById         Int?      @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  contacts  Contact[]
  locations CompanyLocation[]
  leads     Lead[]

  emailMessages  EmailMessage[]
  calendarEvents CalendarEvent[]
  quotations     Quotation[]
  projects       Project[]

  enrichmentRuns        EnrichmentRun[]
  enrichmentSuggestions EnrichmentSuggestion[]
  sourceRecords         SourceRecord[]

  @@index([name])
  @@index([nameNormalised, country])
  @@index([country])
  @@index([status])
  @@index([registrationNumber])
  @@map("companies")
}

model Contact {
  id               Int       @id @default(autoincrement())
  companyId        Int       @map("company_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  designation      String?
  department       String?
  businessEmail    String?   @map("business_email")
  phone            String?
  phoneNormalised  String?   @map("phone_normalised")
  mobile           String?
  mobileNormalised String?   @map("mobile_normalised")
  linkedinUrl      String?   @map("linkedin_url")
  contactType      String    @default("Other") @map("contact_type")
  /// At most one per company: partial unique index contacts_one_primary_per_company (migration SQL).
  isPrimary        Boolean   @default(false) @map("is_primary")
  /// Release 2C: set with the lead's Do not email.
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  isActive         Boolean   @default(true) @map("is_active")
  headline         String?
  location         String?
  about            String?
  /// [{ title, company, from, to, description }]; shape enforced by the shared ContactProfile schema.
  experience       Json      @default("[]")
  /// [{ school, degree, from, to }]
  education        Json      @default("[]")
  /// string[]
  skills           Json      @default("[]")
  /// string[]
  languages        Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leads   Lead[]

  emailMessages       EmailMessage[]
  campaignRecipients  EmailCampaignRecipient[]
  quotations          Quotation[]
  projectStakeholders ProjectStakeholder[]

  @@index([businessEmail])
  @@index([phoneNormalised])
  @@index([mobileNormalised])
  @@index([companyId, lastName])
  @@map("contacts")
}

model CompanyLocation {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  name         String
  locationType String   @map("location_type")
  country      String
  state        String?
  city         String?
  street       String?
  zip          String?
  timezone     String?
  lat          Decimal? @db.Decimal(9, 6)
  lng          Decimal? @db.Decimal(9, 6)
  mapsUrl      String?  @map("maps_url")
  phone        String?
  isVerified   Boolean  @default(false) @map("is_verified")
  source       String   @default("Manual")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_locations")
}

model Lead {
  id               Int       @id @default(autoincrement())
  /// LD-1001 upward; next_lead_number() over lead_number_seq, defined in the migration SQL.
  number           String    @unique @default(dbgenerated("next_lead_number()"))
  /// LEAD_TYPES: Lead | Prospect.
  leadType         String    @default("Lead") @map("lead_type")
  companyName      String    @map("company_name")
  companyId        Int?      @map("company_id")
  contactId        Int?      @map("contact_id")
  website          String?
  businessEmail    String?   @map("business_email")
  phone            String?
  country          String
  city             String?
  /// Lookup `lead_source`.
  leadSource       String    @map("lead_source")
  /// The language the lead is approached in: 'en' | 'es' (outreach-language design, 22 Nov 2026).
  outreachLanguage String    @default("en") @map("outreach_language") @db.Char(2)
  sourceUrl        String?   @map("source_url")
  importBatch      String?   @map("import_batch")
  assignedToId     Int?      @map("assigned_to_id")
  /// PRIORITIES: High | Medium | Low.
  priority         String    @default("Medium")
  /// Lookup `lead_status`.
  status           String    @default("New")
  nextFollowUp     DateTime? @map("next_follow_up") @db.Date
  notes            String?
  /// contact_enquiries does not exist yet; plain column until the Contact Us module adds the relation.
  enquiryId        Int?      @map("enquiry_id")
  enrichmentStatus String    @default("Pending") @map("enrichment_status")
  convertedTo      String?   @map("converted_to")
  /// Release 2C: opted out or unsubscribed; the Mailer skips this lead.
  doNotEmail       Boolean   @default(false) @map("do_not_email")
  archivedAt       DateTime? @map("archived_at")
  createdById      Int?      @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo  User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities  LeadActivity[]
  assignments LeadAssignment[]
  tasks       Task[]

  emailMessages      EmailMessage[]
  campaignRecipients EmailCampaignRecipient[]
  calendarEvents     CalendarEvent[]
  quotations         Quotation[]
  projects           Project[]

  enrichmentRuns EnrichmentRun[]
  sourceRecords  SourceRecord[]

  @@index([status])
  @@index([assignedToId])
  @@index([companyId])
  @@index([leadType])
  @@index([nextFollowUp])
  @@index([createdAt])
  @@index([country])
  @@map("leads")
}

model LeadActivity {
  id           Int      @id @default(autoincrement())
  leadId       Int      @map("lead_id")
  /// ACTIVITY_TYPES.
  activityType String   @map("activity_type")
  title        String
  body         String?
  url          String?
  statusFrom   String?  @map("status_from")
  statusTo     String?  @map("status_to")
  relatedType  String?  @map("related_type")
  relatedId    Int?     @map("related_id")
  /// null = system.
  byUserId     Int?     @map("by_user_id")
  occurredAt   DateTime @default(now()) @map("occurred_at")

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  byUser User? @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

model LeadAssignment {
  id         Int      @id @default(autoincrement())
  leadId     Int      @map("lead_id")
  fromUserId Int?     @map("from_user_id")
  /// null = unassigned.
  toUserId   Int?     @map("to_user_id")
  /// null = allocation rule.
  byUserId   Int?     @map("by_user_id")
  ruleId     Int?     @map("rule_id")
  note       String?
  assignedAt DateTime @default(now()) @map("assigned_at")

  lead     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUser User?           @relation("AssignmentFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser   User?           @relation("AssignmentTo", fields: [toUserId], references: [id], onDelete: SetNull)
  byUser   User?           @relation("AssignmentBy", fields: [byUserId], references: [id], onDelete: SetNull)
  rule     AllocationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([leadId, assignedAt])
  @@map("lead_assignments")
}

model Task {
  id              Int       @id @default(autoincrement())
  leadId          Int?      @map("lead_id")
  quotationId     Int?      @map("quotation_id")
  title           String
  dueDate         DateTime  @map("due_date") @db.Date
  /// TASK_KINDS: followup | call | meeting.
  kind            String    @default("followup")
  /// Wall-clock HH:MM as entered (assignee's local time, no tz shift); required for call and meeting.
  dueTime         String?   @map("due_time") @db.VarChar(5)
  /// TASK_DURATION for a call or meeting; null for a follow-up.
  durationMinutes Int?      @map("duration_minutes")
  assignedToId    Int       @map("assigned_to_id")
  isDone          Boolean   @default(false) @map("is_done")
  doneAt          DateTime? @map("done_at")
  /// TASK_ORIGINS.
  origin          String
  closedReason    String?   @map("closed_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lead       Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotation  Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  assignedTo User       @relation(fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([assignedToId, isDone, dueDate])
  @@index([leadId, origin, isDone])
  @@index([quotationId])
  @@map("tasks")
}

/// Release 3A: a priced quotation for a company (and optionally its lead). `quotation_lines` hold the working copy;
/// each send freezes a `quotation_revisions` snapshot, from which its PDF is drawn again on demand.
model Quotation {
  id                 Int       @id @default(autoincrement())
  /// Q-YYYY-NNN, sequential per calendar year of quotationDate (nextQuotationNumber, advisory lock per year).
  number             String    @unique @db.VarChar(20)
  companyId          Int       @map("company_id")
  contactId          Int?      @map("contact_id")
  leadId             Int?      @map("lead_id")
  ownerId            Int       @map("owner_id")
  quotationDate      DateTime  @map("quotation_date") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date
  /// QUOTE_CURRENCIES: USD | CAD | INR.
  currency           String    @db.VarChar(3)
  subject            String    @db.VarChar(300)
  /// GST %.
  taxRate            Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  overallDiscount    Decimal   @default(0) @map("overall_discount") @db.Decimal(5, 2)
  notes              String    @default("") @db.Text
  /// QUOTE_STATUSES: Draft | Sent | Negotiating | Accepted | Rejected | Expired.
  status             String    @default("Draft") @db.VarChar(20)
  /// The revision being worked on (the last sent one unless editingNewRevision).
  revision           Int       @default(1)
  /// Set when a sent quotation is edited: `revision` is the unsent n+1 until the next send.
  editingNewRevision Boolean   @default(false) @map("editing_new_revision")
  /// The queued email while the quotation shows "Sending…"; cleared when the send job succeeds or finally fails.
  sendingMessageId   Int?      @map("sending_message_id")
  /// The project made from or linked to this quotation (set with Project.quotationId, in one transaction).
  projectId          Int?      @map("project_id")
  /// [{ at: ISO datetime, text }], oldest first.
  history            Json      @default("[]")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact        Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sendingMessage EmailMessage?       @relation(fields: [sendingMessageId], references: [id], onDelete: SetNull)
  project        Project?            @relation("QuotationProject", fields: [projectId], references: [id], onDelete: SetNull)
  linkedProject  Project?            @relation("ProjectQuotation")
  lines          QuotationLine[]
  revisions      QuotationRevision[]
  tasks          Task[]

  @@index([companyId])
  @@index([leadId])
  @@index([ownerId])
  @@index([status])
  @@index([quotationDate])
  @@index([projectId])
  @@map("quotations")
}

model Project {
  id          Int       @id @default(autoincrement())
  /// PRJ-<n>, sequential (nextProjectNumber, advisory lock).
  number      String    @unique @db.VarChar(20)
  companyId   Int       @map("company_id")
  leadId      Int?      @map("lead_id")
  /// One project per quotation; Quotation.projectId points back (both set in one transaction).
  quotationId Int?      @unique @map("quotation_id")
  name        String    @db.VarChar(200)
  /// PROJECT_STATUSES: Active | On hold | Completed | Cancelled.
  status      String    @default("Active") @db.VarChar(20)
  startDate   DateTime  @map("start_date") @db.Date
  value       Decimal?  @db.Decimal(14, 2)
  /// QUOTE_CURRENCIES: USD | CAD | INR.
  currency    String    @db.VarChar(3)
  managerId   Int       @map("manager_id")
  description String?   @db.Text
  createdById Int       @map("created_by_id")
  /// Set when the status becomes Completed, cleared when it moves away.
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lead          Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotation     Quotation?           @relation("ProjectQuotation", fields: [quotationId], references: [id], onDelete: SetNull)
  manager       User                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stakeholders  ProjectStakeholder[]
  quotations    Quotation[]          @relation("QuotationProject")
  emailMessages EmailMessage[]

  @@index([companyId])
  @@index([leadId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

/// Primary stakeholders (prototype): every row is one; copied on every project email.
model ProjectStakeholder {
  projectId Int @map("project_id")
  contactId Int @map("contact_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([projectId, contactId])
  @@index([contactId])
  @@map("project_stakeholders")
}

/// The working copy's lines, in sortOrder.
model QuotationLine {
  id          Int     @id @default(autoincrement())
  quotationId Int     @map("quotation_id")
  sortOrder   Int     @map("sort_order")
  item        String  @db.VarChar(300)
  description String? @db.Text
  qty         Decimal @db.Decimal(12, 2)
  unit        String  @db.VarChar(30)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  /// Line discount %.
  discount    Decimal @default(0) @db.Decimal(5, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, sortOrder])
  @@map("quotation_lines")
}

/// A sent revision, frozen when the send job succeeds. A re-send without edits adds no row.
model QuotationRevision {
  id            Int      @id @default(autoincrement())
  quotationId   Int      @map("quotation_id")
  revisionNo    Int      @map("revision_no")
  sentAt        DateTime @map("sent_at")
  /// The contact address it was emailed to.
  sentTo        String   @map("sent_to") @db.VarChar(320)
  subtotal      Decimal  @db.Decimal(14, 2)
  discountTotal Decimal  @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal  @map("tax_total") @db.Decimal(14, 2)
  grandTotal    Decimal  @map("grand_total") @db.Decimal(14, 2)
  note          String   @default("") @db.Text
  /// QuotationSnapshot: header + lines + totals + company/contact display fields, as printed.
  snapshot      Json
  createdAt     DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, revisionNo])
  @@map("quotation_revisions")
}

/// Settings → Company details (release 3A): one row, id = 1 (CHECK in the migration SQL), seeded with the issuer.
model CompanySettings {
  id           Int      @id @default(1)
  legalName    String   @map("legal_name") @db.VarChar(200)
  /// string[], printed one per line under the legal name.
  addressLines Json     @default("[]") @map("address_lines")
  email        String   @db.VarChar(255)
  /// Printed only on INR quotations, and only when set.
  gstin        String?  @db.VarChar(15)
  taxInr       Decimal  @default(18) @map("tax_inr") @db.Decimal(5, 2)
  taxUsd       Decimal  @default(0) @map("tax_usd") @db.Decimal(5, 2)
  taxCad       Decimal  @default(0) @map("tax_cad") @db.Decimal(5, 2)
  defaultNotes String   @default("") @map("default_notes") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

/// Release 4 AI research: one row per research run on a company (docs/data-model.md enrichment_history).
model EnrichmentRun {
  id           Int       @id @default(autoincrement())
  companyId    Int       @map("company_id")
  /// The lead whose creation triggered an automatic run.
  leadId       Int?      @map("lead_id")
  /// "Manual · <user>" / "New lead LD-…".
  trigger      String    @db.VarChar(120)
  /// "Website reader" / "Website reader + Claude Code <model>".
  engine       String    @db.VarChar(120)
  /// string[]: the sources used (website, places, websearch).
  sources      Json      @default("[]")
  /// "n suggestions", "No website on file", or the error shown in the history.
  result       String    @default("") @db.Text
  appliedCount Int       @default(0) @map("applied_count")
  /// RUN_STATUSES (shared): Pending | Processing | Completed | Failed.
  status       String    @default("Pending") @db.VarChar(20)
  error        String?   @db.Text
  /// Unused since Claude runs through Claude Code (a subscription has no per-call price); always 0.
  costUsd      Decimal   @default(0) @map("cost_usd") @db.Decimal(10, 4)
  /// Google Places Place Details calls made by this run; summed per month against the call cap.
  placesCalls  Int       @default(0) @map("places_calls")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdById  Int?      @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  suggestions EnrichmentSuggestion[]

  @@index([companyId, createdAt])
  @@index([createdAt])
  @@map("enrichment_runs")
}

/// A value a run proposes for one empty, unverified company field, with the page it came from.
model EnrichmentSuggestion {
  id          Int       @id @default(autoincrement())
  runId       Int       @map("run_id")
  companyId   Int       @map("company_id")
  /// RESEARCH_FIELDS (shared) key.
  field       String    @db.VarChar(40)
  label       String    @db.VarChar(80)
  value       Json
  /// How the value reads in the table when it is not a plain string (e.g. a list of services).
  display     String?   @db.Text
  /// 0–100.
  confidence  Int       @db.SmallInt
  sourceUrl   String    @map("source_url") @db.Text
  sourceLabel String    @map("source_label") @db.VarChar(200)
  /// SUGGESTION_DECISIONS (shared): pending | accepted | rejected | superseded.
  decision    String    @default("pending") @db.VarChar(12)
  decidedById Int?      @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")

  run       EnrichmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  decidedBy User?         @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([companyId, decision])
  @@map("enrichment_suggestions")
}

/// Every URL and dataset a company profile was built from (Research Sources tab).
model SourceRecord {
  id              Int      @id @default(autoincrement())
  companyId       Int      @map("company_id")
  leadId          Int?     @map("lead_id")
  title           String   @db.VarChar(200)
  url             String?  @db.VarChar(500)
  /// SOURCE_TYPES (shared), or a MANUAL_SOURCE_TYPES value for a manual record.
  sourceType      String   @map("source_type") @db.VarChar(40)
  collectedAt     DateTime @default(now()) @map("collected_at")
  /// "Enrichment worker" / "<user> (manual)".
  collectedBy     String   @map("collected_by") @db.VarChar(120)
  fieldsPopulated String   @default("") @map("fields_populated") @db.VarChar(500)
  confidence      String   @default("") @db.VarChar(20)
  /// Read-only text extract (first 4,000 visible characters of a page, or manual notes).
  snapshot        String?  @db.Text

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId, collectedAt])
  @@map("source_records")
}

/// Enrichment engine settings (Administrators): one row, id = 1 (CHECK in the migration SQL), seeded with
/// ENRICHMENT_SETTINGS_DEFAULTS (shared). API keys are never stored here: they live in server env variables.
model EnrichmentSettings {
  id                   Int      @id @default(1)
  /// Research runs per day across the CRM; automatic runs are skipped and manual ones refused once reached.
  dailyRunLimit        Int      @default(50) @map("daily_run_limit")
  claudeEnabled        Boolean  @default(false) @map("claude_enabled")
  /// Research runs that use Claude Code per calendar month (UTC); 0 = Claude off.
  claudeMonthlyRunCap  Int      @default(0) @map("claude_monthly_run_cap")
  placesEnabled        Boolean  @default(false) @map("places_enabled")
  /// Place Details calls per calendar month; 0 = Google Places off.
  placesMonthlyCallCap Int      @default(0) @map("places_monthly_call_cap")
  webSearchEnabled     Boolean  @default(false) @map("web_search_enabled")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("enrichment_settings")
}

/// Release 2C Mailer: a personalised template sent to selected leads, one by one, from the sender's mailbox.
model EmailCampaign {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(160)
  templateId        Int?      @map("template_id")
  templateName      String    @map("template_name") @db.VarChar(150)
  templateUpdatedAt DateTime? @map("template_updated_at")
  /// The template's language at queueing (for the opt-out line), kept if the template is deleted.
  language          String    @default("en") @db.VarChar(5)
  /// The template as queued, so later edits do not change the record.
  subject           String    @db.VarChar(500)
  body              String
  senderId          Int       @map("sender_id")
  accountId         Int?      @map("account_id")
  senderAddress     String    @map("sender_address")
  cc                String[]  @default([])
  bcc               String[]  @default([])
  startAt           DateTime? @map("start_at")
  intervalMinutes   Int       @map("interval_minutes")
  workingHoursOnly  Boolean   @default(false) @map("working_hours_only")
  unsubscribeLine   Boolean   @default(true) @map("unsubscribe_line")
  lawfulBasis       String    @map("lawful_basis") @db.VarChar(160)
  /// 'Scheduled' | 'Sending' | 'Paused' | 'Completed' | 'Cancelled'
  status            String
  /// While Paused: why ('Paused by …', 'Mailbox disconnected', …).
  pauseReason       String?   @map("pause_reason")
  /// While Sending: 'working_hours' | 'daily_limit' when nothing can go now.
  waitReason        String?   @map("wait_reason")
  nextSendAt        DateTime? @map("next_send_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  cancelledById     Int?      @map("cancelled_by_id")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  template   EmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sender     User                     @relation("CampaignSender", fields: [senderId], references: [id], onDelete: Cascade)
  account    EmailAccount?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recipients EmailCampaignRecipient[]
  messages   EmailMessage[]

  @@index([status, nextSendAt])
  @@index([senderId, createdAt])
  @@map("email_campaigns")
}

/// One lead in a campaign, with its audit trail (status, when, the filed email, the skip / failure reason).
model EmailCampaignRecipient {
  id             Int       @id @default(autoincrement())
  campaignId     Int       @map("campaign_id")
  leadId         Int?      @map("lead_id")
  contactId      Int?      @map("contact_id")
  toAddress      String    @map("to_address")
  name           String    @default("")
  company        String    @default("")
  timezones      String[]  @default([])
  /// 'company' | 'address' | 'country' | 'sender'
  timezoneSource String    @map("timezone_source")
  /// 'Queued' | 'Sending' | 'Sent' | 'Failed' | 'Skipped'
  status         String
  position       Int
  sentAt         DateTime? @map("sent_at")
  emailMessageId Int?      @map("email_message_id")
  error          String?

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@index([campaignId, status, position])
  @@index([leadId])
  @@map("email_campaign_recipients")
}
